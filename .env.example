# Public site
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SITE_NAME=Figimi
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Server only. Never expose or prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Brevo (contact form email delivery). Server-only — never prefix with NEXT_PUBLIC_.
# The contact form sends messages TO the address in NEXT_PUBLIC_CONTACT_EMAIL.
BREVO_API_KEY=your-brevo-api-key
# A sender address you have verified/authenticated in Brevo (domain or single sender).
BREVO_SENDER_EMAIL=no-reply@figimi.com
BREVO_SENDER_NAME=Figimi Contact

# Optional media hostname proxied/resized by Cloudflare
NEXT_PUBLIC_MEDIA_CDN_URL=https://media.example.com/storage/v1/object/public/media
NEXT_PUBLIC_CLOUDFLARE_IMAGE_RESIZING=false

# Optional environment fallbacks; admin database settings take priority
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_TAG_ID=

# Optional converter binary overrides
LIBREOFFICE_PATH=libreoffice
PDFTOTEXT_PATH=pdftotext
PDFTOPPM_PATH=pdftoppm
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
HEIF_INFO_PATH=heif-info
HEIF_CONVERT_PATH=heif-convert
